{
  "name": "Dependency releases, newest first",
  "steps": [
    {
      "box": "fetch",
      "urls": [
        "https://github.com/fastapi/fastapi/releases.atom",
        "https://github.com/encode/uvicorn/releases.atom"
      ]
    },
    { "box": "merge" },
    { "box": "dedupe", "by": "link" },
    { "box": "sort", "by": "published", "order": "desc" },
    { "box": "limit", "count": 10 }
  ]
}
