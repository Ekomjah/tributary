# Tributary: cloud profile
#
# Copy to .env.cloud (make env-cloud) and run the API with
# `make dev-api-cloud`, or `cd backend && uv run --env-file ../.env.cloud tributary serve`.
#
# Any non-empty DEV_ENV enables the hosted profile, which requires PostgreSQL,
# Auth0 and explicit browser origins. Replace every placeholder before starting.
# Additional storage, pool, CORS and Sentry options are documented in .env.example.

DEV_ENV=production

# PostgreSQL. Use the Neon pooled host for DATABASE_URL and the direct host for
# migrations. Both URLs need sslmode=require.
DATABASE=postgres
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/tributary?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/tributary?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/tributary?sslmode=require

# PostgreSQL pool. Each process opens at most POOL_SIZE + MAX_OVERFLOW
# connections.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=300
# DATABASE_CONNECT_TIMEOUT=10

# Auth0. The SPA uses the client ID and audience; the API validates tokens
# against the tenant's JWKS and issuer.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.example.com
AUTH0_CLIENT_ID=your-spa-client-id
# Optional private beta allowlists. Empty allows any valid token from the tenant.
# AUTH0_ALLOWED_SUBS=auth0|abc123,auth0|def456
# AUTH0_ALLOWED_EMAILS=ada@example.com,grace@example.com

# Browser origins allowed to call the API. Required in cloud mode.
CORS_ORIGINS=https://app.example.com
# CORS_ORIGIN_REGEX=^https://tributary-[a-z0-9-]+\.vercel\.app$

# Ollama Cloud. Article text and prompts leave the machine; the key is required.
OLLAMA_CLOUD=true
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_CLOUD_MODEL=gemma4:3b
OLLAMA_CLOUD_HOST=https://ollama.com

# Web search is off until a SerpAPI key is set.
SERPAPI_API_KEY=

# Sentry is opt-in. Leave the DSN empty to run without Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
