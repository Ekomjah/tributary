# Tributary configuration
#
# Runtime profile: leave DEV_ENV unset or empty for the local, account-free
# build. Any non-empty value (for example "production") enables cloud mode,
# which requires PostgreSQL, Auth0 and an explicit CORS origin.
DEV_ENV=

# Storage. SQLite is the default and needs no configuration. The path is
# relative to the repository root unless absolute.
TRIBUTARY_DB_PATH=tributary.db

# Set DATABASE_URL to use PostgreSQL instead of SQLite. Render's postgres://
# and postgresql:// URLs are accepted and normalized to psycopg. In cloud mode
# this variable is required and must point at PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/tributary

# Optional storage selector. Empty infers the backend from DATABASE_URL (or
# SQLite when it is unset). Set DATABASE=postgres on a hosted deployment so a
# missing DATABASE_URL fails at startup instead of creating a throwaway SQLite
# file on an ephemeral filesystem.
# DATABASE=postgres

# Neon. DATABASE_URL should use the pooled "-pooler" host: PgBouncer in
# transaction mode absorbs the app's connections while Neon's compute sleeps.
# Migrations should use the direct host. `neon env pull` writes it as
# DATABASE_URL_UNPOOLED, which the app reads automatically; MIGRATION_DATABASE_URL
# is an explicit override. Both URLs need sslmode=require.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/tributary?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/tributary?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/tributary?sslmode=require

# PostgreSQL pool. Each process opens at most POOL_SIZE + MAX_OVERFLOW
# connections. Pre-ping and recycling recover from Neon's idle suspensions.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=300
# DATABASE_CONNECT_TIMEOUT=10

# Ollama powers the AI boxes and natural-language search refinement.
# Local mode (default): gemma3:1b on this machine. These values are optional;
# the same defaults apply when the lines are left commented out.
# OLLAMA_MODEL=gemma3:1b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=120
#
# Cloud mode: set OLLAMA_CLOUD=true and OLLAMA_API_KEY. Prompts and article
# text then leave this machine, and Ollama's cloud usage limits apply. Use the
# cloud model/host overrides if your account exposes a different tag or you
# route through a gateway. The app refuses to start when cloud mode has no key.
OLLAMA_CLOUD=false
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_MODEL=gemma4:3b
# OLLAMA_CLOUD_HOST=https://ollama.com

# Optional server overrides.
# TRIBUTARY_HOST=127.0.0.1
# TRIBUTARY_PORT=8000
# TRIBUTARY_LOG_LEVEL=INFO

# Feed fetching.
# TRIBUTARY_FETCH_TIMEOUT=20

# Web search. The Search box and `tributary search` stay off until a key is set.
# Get one at https://serpapi.com. Only the query and search options are sent,
# never article text or reading history.
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_news
SERPAPI_MAX_RESULTS=10
SERPAPI_CACHE_TTL=21600
SERPAPI_TIMEOUT=20

# Sentry is opt-in. Leave SENTRY_DSN empty to run without Sentry: no errors,
# traces, logs, metrics or GenAI spans leave the process. Set a DSN to enable
# them, or set SENTRY_ENABLED=false as a hard opt-out even when a DSN exists.
# Monitoring captures request bodies (up to 10 KB), headers, query strings,
# database query data, stack variables and GenAI prompts/responses. Cookies,
# GraphQL and queues stay off. API keys and URL query strings are redacted.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=development
# Share of requests traced and traces profiled, from 0 to 1. A value of 0 keeps
# error reporting on while turning tracing off.
SENTRY_TRACES_SAMPLE_RATE=0.25
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Data collection. The defaults are tuned for monitoring; set any to false to
# hide that category. Secrets are still filtered by the SDK denylist and the
# Tributary scrubber.
SENTRY_SEND_USER_INFO=true
SENTRY_COLLECT_HTTP_HEADERS=true
SENTRY_COLLECT_HTTP_BODIES=true
SENTRY_COLLECT_QUERY_PARAMS=true
SENTRY_COLLECT_GEN_AI=true
SENTRY_COLLECT_DB_QUERIES=true
SENTRY_COLLECT_STACK_VARIABLES=true
SENTRY_FRAME_CONTEXT_LINES=5
# never, small (1 KB), medium (10 KB) or always.
SENTRY_MAX_REQUEST_BODY_SIZE=medium

# Browser origins allowed to call the API. Comma-separated or a JSON list.
# Local mode defaults to localhost:3000; cloud mode requires this explicitly.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Optional anchored regex for scoped preview deployments. Do not use a pattern
# that matches every origin.
# CORS_ORIGIN_REGEX=^https://tributary-[a-z0-9-]+\.vercel\.app$

# Auth0 (cloud mode only). The SPA uses client ID + audience; the backend
# validates tokens against the tenant's JWKS and issuer.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://api.example.com
# AUTH0_CLIENT_ID=your-spa-client-id
# Optional private beta: comma-separated Auth0 subject ids and/or verified
# emails. Empty allows any valid token from the tenant. Access tokens only
# contain an email claim when an Auth0 Action adds one; the backend requires
# email_verified=true before accepting an email allowlist match.
# AUTH0_ALLOWED_SUBS=auth0|abc123,auth0|def456
# AUTH0_ALLOWED_EMAILS=ada@example.com,grace@example.com

# Frontend development only (put this in frontend/.env.local):
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
