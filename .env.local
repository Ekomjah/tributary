# Tributary: local / self-hosted profile
#
# Copy to .env.local (make env-local) and run the API with
# `make dev-api-local`, or `cd backend && uv run --env-file ../.env.local tributary serve`.
#
# This profile is account-free: SQLite on this machine and Ollama on this
# machine. Nothing here needs to be filled in for a basic install. Every
# switch, including the full Sentry options, is documented in .env.example.

# Empty DEV_ENV keeps the local, account-free build.
DEV_ENV=

# SQLite database file, relative to the repository root unless absolute.
TRIBUTARY_DB_PATH=tributary.db

# Local Ollama powers the AI boxes and search refinement. Pull the model once:
#   ollama pull gemma3:1b
OLLAMA_CLOUD=false
OLLAMA_MODEL=gemma3:1b
OLLAMA_HOST=http://localhost:11434

# Web search is off until a SerpAPI key is set. Get one at https://serpapi.com.
SERPAPI_API_KEY=

# Sentry is opt-in. Leave the DSN empty to run without Sentry.
SENTRY_DSN=

# The reader only needs NEXT_PUBLIC_API_BASE, and it reads frontend/.env.local,
# not this file:
#   NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
